# Ghostty configuration
# Migrated from iTerm2 "Default" profile (com.googlecode.iterm2)

# ---------------------------------------------------------------------------
# Font
# ---------------------------------------------------------------------------
# iTerm2 "Normal Font" was: MesloLGS-NF-Regular 15
font-family = MesloLGS-NF-Regular
font-size = 14

# iTerm2 "Vertical Spacing" = 1.28 (28% extra height).
# Remove/comment this line if you prefer the font's natural spacing.
adjust-cell-height = 28%

# ---------------------------------------------------------------------------
# Color scheme
# ---------------------------------------------------------------------------
# Background / foreground
background = #000000
foreground = #f8f8f2

# Cursor
# Solid block when focused. Ghostty automatically renders a hollow block
# (box outline) when the surface/window is unfocused. See renderer/cursor.zig.
cursor-style = block
cursor-color = #ffa827
cursor-text = #000000

# Selection
selection-background = #403d3d
selection-foreground = #ffffff

# ANSI palette (0-15)
palette = 0=#222222
palette = 1=#f92a72
palette = 2=#a6e22e
palette = 3=#ffa827
palette = 4=#ae81ff
palette = 5=#f92a72
palette = 6=#66d9ef
palette = 7=#cfcfc2
palette = 8=#75715e
palette = 9=#f92a72
palette = 10=#a6e22e
palette = 11=#e6db74
palette = 12=#ae81ff
palette = 13=#f92a72
palette = 14=#66d9ef
palette = 15=#f8f8f2

# ---------------------------------------------------------------------------
# Splits
# ---------------------------------------------------------------------------
# Dim unfocused split panes, but more subtly than the Ghostty default of 0.7.
# Lower values fade the pane more; 1.0 disables dimming entirely.
unfocused-split-opacity = 0.85

# Subtle grey divider line between split panes (against the #000000 bg).
split-divider-color = #2a2a2a

# ---------------------------------------------------------------------------
# Shell integration
# ---------------------------------------------------------------------------
# Keep the block cursor at the shell prompt. By default shell integration
# switches the cursor to a bar, which defeats the focused/unfocused block
# behavior above.
shell-integration-features = no-cursor,no-sudo,title,no-ssh-env,no-ssh-terminfo,path

# ---------------------------------------------------------------------------
# Tmux pane management (conditional)
# ---------------------------------------------------------------------------
# iTerm-like tmux pane controls, but croft wins them while its pane is focused.
# Sent as tmux prefix + C-v + slot; tmux's `croft` key table (see .tmux.conf)
# forwards the real chord to croft when it is the focused pane, otherwise it
# runs the pane action. A key-table sequence rather than CSI-u keeps genuine
# Alt chords out of the dispatch.
#
# NOTE: re-running `croft setup-ghostty` re-adds these chords to its managed
# block as CSI-u, which would win over these lines. Remove them again (the
# eight `cmd+d`, `cmd+shift+d`, `cmd+w`, `cmd+shift+enter`, and
# `cmd+alt+arrow_*` lines) after a re-run.
#
# split right (vertical divider)
keybind = super+d=text:\x01\x16d
# split down
keybind = super+shift+d=text:\x01\x16D
# kill pane
keybind = super+w=text:\x01\x16w
# zoom / unzoom pane
keybind = super+shift+enter=text:\x01\x16e
# Cmd+Enter stays Ghostty's toggle_fullscreen. Croft's insert-line-below is
# Ctrl+Enter, which Ghostty delivers natively through the kitty keyboard
# protocol, so no forwarder or tmux slot is needed.
# move pane focus
keybind = super+alt+arrow_left=text:\x01\x16h
keybind = super+alt+arrow_right=text:\x01\x16l
keybind = super+alt+arrow_up=text:\x01\x16k
keybind = super+alt+arrow_down=text:\x01\x16j

# ---------------------------------------------------------------------------
# croft settings
# ---------------------------------------------------------------------------
# Ghostty's default cmd+, opens Ghostty's own config; send it to croft instead
# (croft's keybindings.json binds mod+, to open_settings). `croft setup-ghostty`
# also forwards this from keybindings.json on its next run.
keybind = super+,=csi:44;9u
# Cmd+N opens a new empty tab in croft (keybindings.json binds mod+n to
# new_file); Ghostty's default there is new_window.
keybind = super+n=csi:110;9u

# ---------------------------------------------------------------------------
# Sublime/Atom editor chords
# ---------------------------------------------------------------------------
# Ghostty has no defaults for most of these, and Cmd+Shift+Up/Down would
# otherwise hit its jump_to_prompt; forward them so the keybindings.json
# bindings fire. Cmd+Alt+Left/Right still route through the tmux croft table.
# Sublime/Atom editor chords. The colliding Cmd chords go through tmux's
# `croft` key table so croft receives true Cmd while genuine Alt chords stay
# Alt (the promotion patch skips them); Cmd+L has no Alt collision, so it is
# forwarded normally.
#
# Ghostty's defaults send `ESC b` / `ESC f` for Alt+Left/Right; croft reads
# those as Alt+B/Alt+F and the Cmd promotion turns them into Cmd+B (sidebar)
# and Cmd+F (find). Forward the real Alt+Left/Right so croft's word motion runs.
keybind = alt+arrow_left=csi:1;3D
keybind = alt+arrow_right=csi:1;3C
keybind = super+left=text:\x01\x161
keybind = super+right=text:\x01\x162
keybind = super+up=text:\x01\x163
keybind = super+down=text:\x01\x164
keybind = super+shift+left=text:\x01\x165
keybind = super+shift+right=text:\x01\x166
keybind = super+shift+up=text:\x01\x167
keybind = super+shift+down=text:\x01\x168
keybind = super+backspace=text:\x01\x16b
keybind = super+delete=text:\x01\x16f
keybind = super+l=csi:108;9u

# ---------------------------------------------------------------------------
# dev-workspace swap-pane tabs
# ---------------------------------------------------------------------------
# Ctrl+Tab / Ctrl+Shift+Tab cycle the editor/review/docs swap pane from any view
# (including croft). Sent as tmux prefix + C-v + slot, like the Cmd pane chords:
# tmux's `croft` key table slots p / P run `dev-workspace swap`. Croft's own Go
# to Tab moved to Ctrl+Alt+Tab / Ctrl+Alt+Shift+Tab (slots a / A). See .tmux.conf.
#
# NOTE: `croft setup-ghostty` does not emit these (it only forwards Cmd chords),
# so re-running it is safe here.
keybind = ctrl+tab=text:\x01\x16p
keybind = ctrl+shift+tab=text:\x01\x16P
keybind = ctrl+alt+tab=text:\x01\x16a
keybind = ctrl+alt+shift+tab=text:\x01\x16A

# ---------------------------------------------------------------------------
# Quit
# ---------------------------------------------------------------------------
# tmux owns session lifetime: cmd+q only detaches and resurrect reattaches the
# workspace, so there is nothing to lose by closing a surface. Disable Ghostty's
# default "process is running, close anyway?" prompt.
confirm-close-surface = false


