# <<< croft keybindings (managed by `croft setup-ghostty`) <<<

# Cmd+Ctrl+R resets the current dev-workspace (same as prefix R): one chord
# instead of the tmux prefix, for picking up a build or config change. Sent as
# tmux prefix + R; the binding in .tmux.conf resolves the profile from the
# invoking session and runs `dev-workspace restart`. Deliberately off croft's
# own Cmd chords (`cmd+shift+r` is croft's), so nothing forwards it.
keybind = super+ctrl+r=text:\x01R
# Private / company overlay (optional). Kept out of this public repo; see the
# agent-skills overlay/. Ghostty ignores a missing `?`-prefixed include.
config-file = ?~/.config/dotfiles/ghostty.conf

# Open-file picker: Cmd+O routes through tmux's `croft` key table (slot o) so
# dev-workspace can run the fzf picker over ~/Projects in a popup. Keep after
# the managed block so it wins over any managed Cmd+O line.
keybind = super+o=text:\x01\x16o

# Pi transcript chords. Route Cmd+F / Cmd+T through tmux's `croft` key table
# (slots g / t, see .tmux.conf) so the raw super+f / super+t reach the focused
# pane. tmux drops the direct CSI-u for panes that did not enable extkeys, which
# is why these mirror the Cmd+Up/Down handling. Keep these lines after the
# managed croft block so they win: a later keybind overrides an earlier one.
keybind = cmd+f=text:\x01\x16g
keybind = cmd+t=text:\x01\x16t

# Native Mac copy/paste. The managed croft block above forwards cmd+c (and other
# cmd+ keys) to the focused app for croft's own copy/paste, which does nothing in
# tmux or pi. Re-assert the Ghostty defaults after it so cmd+c copies the
# terminal selection and cmd+v pastes it everywhere, including the box session.
# Keep these last, and re-add them if `croft setup-ghostty` ever runs again:
# a later keybind overrides an earlier one.
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
