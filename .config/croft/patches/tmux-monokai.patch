+/// The Ghostty/iTerm Monokai 16-colour ANSI palette (black..bright white),
+/// the same values the tracked croft theme uses. Chrome colours are snapped to
+/// the nearest of these so they render through the host terminal's *numbered*
+/// colours rather than truecolor, and follow a terminal palette change.
+const MONOKAI_ANSI: [(u8, u8, u8); 16] = [
+    (0x22, 0x22, 0x22),
+    (0xf9, 0x2a, 0x72),
+    (0xa6, 0xe2, 0x2e),
+    (0xff, 0xa8, 0x27),
+    (0xae, 0x81, 0xff),
+    (0xf9, 0x2a, 0x72),
+    (0x66, 0xd9, 0xef),
+    (0xcf, 0xcf, 0xc2),
+    (0x75, 0x71, 0x5e),
+    (0xf9, 0x2a, 0x72),
+    (0xa6, 0xe2, 0x2e),
+    (0xe6, 0xdb, 0x74),
+    (0xae, 0x81, 0xff),
+    (0xf9, 0x2a, 0x72),
+    (0x66, 0xd9, 0xef),
+    (0xf8, 0xf8, 0xf2),
+];
+
 pub fn rgb_color((r, g, b): (u8, u8, u8)) -> Color {
-    Color::Rgb(r, g, b)
+    // Snap to the nearest terminal ANSI index so croft's chrome is painted with
+    // the host terminal's numbered colours (Ghostty's Monokai palette) instead
+    // of truecolor. A palette change on the terminal is then picked up for free.
+    let mut best = 0u8;
+    let mut best_d = i32::MAX;
+    for (i, (pr, pg, pb)) in MONOKAI_ANSI.iter().enumerate() {
+        let dr = r as i32 - *pr as i32;
+        let dg = g as i32 - *pg as i32;
+        let db = b as i32 - *pb as i32;
+        let d = dr * dr + dg * dg + db * db;
+        if d < best_d {
+            best_d = d;
+            best = i as u8;
+        }
+    }
+    Color::Indexed(best)
 }
 
