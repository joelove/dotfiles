#!/usr/bin/env bash
#
# candela-workspace - thin wrapper over the generic dev-workspace engine.
#
# Kept so skhd, the gh-dash keybinding and the tmux hooks can call the candela
# profile by name. See dev-workspace for the engine and
# ~/.config/dev-workspace/candela.conf for the profile.
#
exec "$(cd "$(dirname "$0")" && pwd)/dev-workspace" candela "$@"
