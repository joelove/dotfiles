#!/usr/bin/env bash
#
# candela-workspace - tmux-backed Ghostty workspace for the Candela repos.
#
# Two tmux sessions mirror the two Ghostty windows:
#   candela-pi   two panes, each running pi in ~/Projects/candela
#   candela-prs  four panes: nvim + gh-dash on top, two shells below
#
# Usage:
#   candela-workspace build              create both sessions if missing
#   candela-workspace attach [session]   ensure sessions, then attach
#   candela-workspace attach-only [s]    attach without touching the layout
#   candela-workspace open               open both Ghostty windows
#   candela-workspace review <pr>        open a PR in the editor nvim (octo)
#   candela-workspace post-restore       resurrect hook (start pi again)
#
set -euo pipefail

# Give the tmux server (and therefore every pane) a complete environment even
# when we are launched by launchd / `open` with a minimal PATH.
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.nvm/versions/node/v24.12.0/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

TMUX_BIN="/opt/homebrew/bin/tmux"
CANDELA="$HOME/Projects/candela"
PI_BIN="/Users/joelove/.nvm/versions/node/v24.12.0/bin/pi"
SELF="/Users/joelove/.local/bin/candela-workspace"
RESURRECT_DIR="$HOME/.local/share/tmux/resurrect"
RESURRECT_RESTORE="$HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh"
LOCKDIR="/tmp/candela-workspace.lock"

have() { "$TMUX_BIN" has-session -t "$1" 2>/dev/null; }

# True when a client is attached to the session, i.e. a terminal window is
# viewing it. This is the source of truth for whether the workspace is open.
have_client() { "$TMUX_BIN" list-clients -t "$1" -F '#{client_tty}' 2>/dev/null | grep -q .; }

# --- session builders -------------------------------------------------------

build_pi() {
  have candela-pi && return 0
  local left right
  left=$("$TMUX_BIN" new-session -d -s candela-pi -n agent -c "$CANDELA" -P -F '#{pane_id}')
  right=$("$TMUX_BIN" split-window -h -t "$left" -c "$CANDELA" -P -F '#{pane_id}')
  "$TMUX_BIN" set-option -p -t "$left"  @pi_started 1
  "$TMUX_BIN" set-option -p -t "$right" @pi_started 1
  "$TMUX_BIN" send-keys -t "$left"  "$PI_BIN" Enter
  "$TMUX_BIN" send-keys -t "$right" "$PI_BIN" Enter
}

build_prs() {
  have candela-prs && return 0
  local top bottom bottom_right top_right
  top=$("$TMUX_BIN" new-session -d -s candela-prs -n editor -c "$CANDELA" -P -F '#{pane_id}')
  # bottom strip (14 lines)
  bottom=$("$TMUX_BIN" split-window -v -t "$top" -l 14 -c "$CANDELA/candela-infra" -P -F '#{pane_id}')
  bottom_right=$("$TMUX_BIN" split-window -h -t "$bottom" -l 50% -c "$CANDELA/candela-orchestrator" -P -F '#{pane_id}')
  # top row right (76 cols)
  top_right=$("$TMUX_BIN" split-window -h -t "$top" -l 76 -c "$CANDELA" -P -F '#{pane_id}')
  "$TMUX_BIN" set-option -p -t "$top" @candela_review_pane 1
  "$TMUX_BIN" send-keys -t "$top"       "nvim ." Enter
  "$TMUX_BIN" send-keys -t "$top_right" "gh dash" Enter
}

build() { build_pi; build_prs; }

# --- ensure -----------------------------------------------------------------

latest_save() {
  ls -t "$RESURRECT_DIR"/tmux_resurrect_*.txt 2>/dev/null | head -1
}

# Start pi in any candela-pi pane that is sitting at a plain shell. A pane
# option marks a pane as already handled so the ensure step and the resurrect
# hook can both call this without starting pi twice.
start_pi_in_shells() {
  have candela-pi || return 0
  local pane cmd mark
  while IFS= read -r pane; do
    mark=$("$TMUX_BIN" show-options -p -t "$pane" -qv @pi_started 2>/dev/null || true)
    [ "$mark" = "1" ] && continue
    cmd=$("$TMUX_BIN" display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null || echo '')
    case "$cmd" in
      zsh|bash|sh|-zsh|-bash)
        "$TMUX_BIN" set-option -p -t "$pane" @pi_started 1
        "$TMUX_BIN" send-keys -t "$pane" "$PI_BIN" Enter
        ;;
    esac
  done < <("$TMUX_BIN" list-panes -t candela-pi -F '#{pane_id}' 2>/dev/null)
}

# Re-apply the editor window's fixed layout and pane tag. tmux-resurrect
# restores panes but not user pane options, and it restores the layout it
# saved, so a restart would otherwise bring back old sizes. Runs on every
# ensure and after a manual resurrect restore.
normalize_editor() {
  have candela-prs || return 0
  local panes top_min bot_max nvim gh bottom
  panes=$("$TMUX_BIN" list-panes -t candela-prs -F '#{pane_id} #{pane_top} #{pane_left}' 2>/dev/null) || return 0
  [ -n "$panes" ] || return 0

  top_min=$(printf '%s\n' "$panes" | awk '{ print $2 }' | sort -n | head -n1)
  bot_max=$(printf '%s\n' "$panes" | awk '{ print $2 }' | sort -n | tail -n1)

  # gh-dash is the rightmost top pane, nvim the leftmost; resize the leftmost
  # bottom pane to set the row height.
  gh=$(printf '%s\n' "$panes" | awk -v t="$top_min" '$2 == t { print $3, $1 }' | sort -n | tail -n1 | awk '{ print $2 }')
  nvim=$(printf '%s\n' "$panes" | awk -v t="$top_min" '$2 == t { print $3, $1 }' | sort -n | head -n1 | awk '{ print $2 }')
  bottom=$(printf '%s\n' "$panes" | awk -v t="$bot_max" '$2 == t { print $3, $1 }' | sort -n | head -n1 | awk '{ print $2 }')

  [ -n "$gh" ] && "$TMUX_BIN" resize-pane -t "$gh" -x 76 2>/dev/null || true
  [ -n "$bottom" ] && "$TMUX_BIN" resize-pane -t "$bottom" -y 14 2>/dev/null || true
  [ -n "$nvim" ] && "$TMUX_BIN" set-option -p -t "$nvim" @candela_review_pane 1 2>/dev/null || true
  return 0
}

# Debounced normalize_editor for the window-resized hook: a window drag emits
# many resize events, so only the last one in a burst re-applies the layout.
normalize_editor_debounced() {
  local stamp="/tmp/candela-workspace.normalize" mine
  mine="$(date +%s).$$.$RANDOM"
  printf '%s' "$mine" > "$stamp" 2>/dev/null || return 0
  sleep 0.25
  [ "$(cat "$stamp" 2>/dev/null || true)" = "$mine" ] || return 0
  normalize_editor
}

# Restore the last resurrect save, synchronously, into the running server.
restore_from_save() {
  local socket
  socket=$("$TMUX_BIN" display-message -p '#{socket_path}' 2>/dev/null || true)
  [ -n "$socket" ] || return 1
  [ -n "$(latest_save)" ] || return 1
  TMUX="$socket,0,0" bash "$RESURRECT_RESTORE" >/dev/null 2>&1 || true
}

ensure_unlocked() {
  "$TMUX_BIN" start-server 2>/dev/null || true
  if ! have candela-pi || ! have candela-prs; then
    if [ -n "$(latest_save)" ]; then
      # Keep the server alive while restoring from scratch.
      local tmp="__candela_workspace_tmp__"
      have "$tmp" || "$TMUX_BIN" new-session -d -s "$tmp" -c "$CANDELA" 2>/dev/null || true
      restore_from_save
      have "$tmp" && "$TMUX_BIN" kill-session -t "$tmp" 2>/dev/null || true
      # resurrect restores pi as a generic `node`, so it comes back as a shell.
      sleep 1
      start_pi_in_shells
    fi
  fi
  build
  normalize_editor
}

ensure() {
  while ! mkdir "$LOCKDIR" 2>/dev/null; do sleep 0.2; done
  trap 'rmdir "$LOCKDIR" 2>/dev/null || true' EXIT
  ensure_unlocked
  rmdir "$LOCKDIR" 2>/dev/null || true
  trap - EXIT
}

# --- actions ----------------------------------------------------------------

attach() {
  local session="${1:-candela-prs}"
  ensure
  "$TMUX_BIN" attach-session -t "$session"
}

attach_only() {
  "$TMUX_BIN" attach-session -t "${1:-candela-prs}"
}

# --- PR review integration --------------------------------------------------

# Canonicalize a PR reference to a GitHub URL. Accepts a full URL,
# owner/repo#123, or owner/repo 123.
pr_url() {
  local ref="${1:-}" num="${2:-}"
  case "$ref" in
    https://*) printf '%s' "$ref" ;;
    *"#"*)     printf 'https://github.com/%s/pull/%s' "${ref%%#*}" "${ref##*#}" ;;
    */*)       [ -n "$num" ] && printf 'https://github.com/%s/pull/%s' "$ref" "$num" || return 1 ;;
    *)         return 1 ;;
  esac
}

# The editor nvim pane, tagged in build_prs. Empty when the workspace is down.
review_pane() {
  "$TMUX_BIN" list-panes -a -F '#{pane_id} #{@candela_review_pane}' 2>/dev/null \
    | awk '$2 == "1" { print $1; exit }' || true
}

# Open a PR in the editor pane's nvim (octo.nvim) and enter review mode.
review() {
  local url pane
  url=$(pr_url "$@") || { echo "usage: candela-workspace review <pr-url|owner/repo#n|owner/repo n>" >&2; return 1; }
  pane=$(review_pane)
  if [ -n "$pane" ] && [ "$("$TMUX_BIN" display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null)" = "nvim" ]; then
    "$TMUX_BIN" send-keys -t "$pane" Escape
    "$TMUX_BIN" send-keys -t "$pane" -l ":Octo $url"
    "$TMUX_BIN" send-keys -t "$pane" Enter
    # octo fetches the PR asynchronously; give it a moment before review mode.
    sleep 2
    "$TMUX_BIN" send-keys -t "$pane" -l ":Octo review"
    "$TMUX_BIN" send-keys -t "$pane" Enter
  else
    echo "candela-workspace: editor pane is not running nvim; opening $url in the browser" >&2
    /usr/bin/open "$url"
  fi
}

# Create one Ghostty window attached to a session, inside the existing Ghostty
# app instance. Ghostty runs a multiple-argument `command` through /bin/sh -c,
# so the attach-only invocation works as written.
new_ghostty_window() {
  local session="$1"
  osascript - "$SELF" "$session" <<'APPLESCRIPT'
on run argv
  set cmd to (item 1 of argv) & " attach-only " & (item 2 of argv)
  tell application "Ghostty"
    set cfg to new surface configuration
    set command of cfg to cmd
    new window with configuration cfg
  end tell
end run
APPLESCRIPT
}

# Focus the Ghostty window backing each tmux session. `open -a` alone only
# raises windows already on the active space, so find each window by its
# session title (set via tmux `set-titles`) and let yabai switch the display to
# the window's space, including a native fullscreen space.
focus_workspace_windows() {
  local title id
  for title in agent editor; do
    id=$(yabai -m query --windows 2>/dev/null \
      | jq -r --arg t "$title" '.[] | select(.app=="Ghostty" and .title==$t) | .id' \
      | head -n1)
    if [ -n "$id" ]; then
      yabai -m window --focus "$id" 2>/dev/null || true
    fi
  done
  /usr/bin/open -a /Applications/Ghostty.app
}

open_windows() {
  ensure

  # Already open: swap to each window's space and focus the app; spawn nothing.
  if have_client candela-pi && have_client candela-prs; then
    focus_workspace_windows
    return 0
  fi

  # Start a single windowless app instance if Ghostty is not already running.
  # (`--initial-window=false` is only applied on this fresh launch, so a normal
  # double-click launch still opens a window.)
  if ! pgrep -x ghostty >/dev/null 2>&1; then
    /usr/bin/open -a /Applications/Ghostty.app --args --initial-window=false
    local i
    for i in $(seq 1 50); do
      osascript -e 'tell application "Ghostty" to count windows' >/dev/null 2>&1 && break
      sleep 0.1
    done
  fi

  # Create only the windows whose session has no attached client.
  have_client candela-pi  || new_ghostty_window candela-pi
  have_client candela-prs || new_ghostty_window candela-prs
}

# Called by tmux-resurrect after a manual restore. resurrect sees pi as a
# generic `node` process and cannot relaunch it, so restart it in the pi
# session.
post_restore() {
  sleep 1.5
  start_pi_in_shells
  normalize_editor
}

case "${1:-open}" in
  build)       build ;;
  ensure)      ensure ;;
  attach)      attach "${2:-candela-prs}" ;;
  attach-only) attach_only "${2:-candela-prs}" ;;
  open)        open_windows ;;
  review)      review "${2:-}" "${3:-}" ;;
  normalize-editor) normalize_editor_debounced ;;
  post-restore) post_restore ;;
  *) echo "usage: candela-workspace [build|ensure|attach <session>|attach-only <session>|open|review <pr>|post-restore]" >&2; exit 1 ;;
esac
