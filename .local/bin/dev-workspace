#!/usr/bin/env bash
#
# dev-workspace - generic tmux/Ghostty workspace engine.
#
# A workspace is a sourced bash profile describing one agent view and one
# editor view. Profiles live in ~/.config/dev-workspace/<name>.conf; the
# built-in default profile ("projects") is the full two-session layout rooted
# at ~/Projects. Wrappers are thin: `exec dev-workspace <name> "$@"`.
#
# Usage:
#   dev-workspace [<profile>] <command> [args]
#
# Commands:
#   open (default)        ensure sessions and open/focus the Ghostty windows
#   build                 create missing sessions
#   ensure                restore missing sessions, then re-pin the layout
#   attach [session]      ensure, then attach (default: editor session)
#   attach-only [session] attach without touching sessions or layout
#   review-pane           (re)launch the review pane command only if it is closed
#   swap [mode] [--session NAME]   cycle/select the swappable pane tab
#                         (next|prev|editor|review|docs; default next)
#   open-review [--session NAME] [--path DIR] [--repo O/R] --pr N
#                         load PR N into the lumen review tab and raise it
#   open-file [--session NAME] [--root DIR]
#                         fzf a file under ~/Projects in a tmux popup and open
#                         it in the croft hosting the editor session (Cmd+O)
#   normalize-editor [--all]   re-pin the pane sizes and review-pane tag
#   post-restore [--all]       resurrect hook: restart the agent and normalize
#   restart [--session NAME] [--all]
#                         reset a workspace: kill and rebuild its sessions,
#                         then reopen the Ghostty windows
#   list                  list profiles
#   print-config          print the resolved profile fields
#
set -euo pipefail

# Give the tmux server (and therefore every pane) a complete environment even
# when we are launched by launchd / `open` with a minimal PATH.
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.nvm/versions/node/v24.12.0/bin:$HOME/.cargo/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

TMUX_BIN="/opt/homebrew/bin/tmux"
DEV_CONFIG_DIR="$HOME/.config/dev-workspace"
DEV_SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
RESURRECT_DIR="$HOME/.local/share/tmux/resurrect"
RESURRECT_RESTORE="$HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh"
DEFAULT_PROFILE="projects"

have() { "$TMUX_BIN" has-session -t "$1" 2>/dev/null; }

# True when a client is attached to the session, i.e. a terminal window is
# viewing it. This is the source of truth for whether the workspace is open.
have_client() { "$TMUX_BIN" list-clients -t "$1" -F '#{client_tty}' 2>/dev/null | grep -q .; }

# --- profiles ---------------------------------------------------------------

reset_profile() {
  unset DEV_NAME DEV_ROOT DEV_AGENT_DIR DEV_AGENT_CMD DEV_AGENT_PANES DEV_AGENT_SESSION \
    DEV_EDITOR_DIR DEV_EDITOR_CMD DEV_EDITOR_SESSION DEV_REVIEW_CMD DEV_REVIEW_SUB_CMD \
    DEV_REVIEW_SUB_LINES DEV_GH_COLS DEV_BOTTOM_LINES DEV_TERM_DIRS DEV_TERM_PATHS DEV_TERM_CMDS \
    DEV_SWAP_DEFAULT DEV_SWAP_REVIEW_CMD DEV_SWAP_DOCS_CMD DEV_SWAP_POOL_WINDOW
}

apply_defaults() {
  DEV_ROOT="${DEV_ROOT:-$HOME/Projects}"
  case "$DEV_ROOT" in "~"*) DEV_ROOT="$HOME${DEV_ROOT#\~}" ;; esac
  DEV_NAME="${DEV_NAME:-$(basename "$DEV_ROOT" | tr '[:upper:]' '[:lower:]')}"
  DEV_AGENT_DIR="${DEV_AGENT_DIR:-$DEV_ROOT}"
  DEV_AGENT_CMD="${DEV_AGENT_CMD-pi}"
  DEV_AGENT_PANES="${DEV_AGENT_PANES:-2}"
  DEV_AGENT_SESSION="${DEV_AGENT_SESSION:-$DEV_NAME-agent}"
  DEV_EDITOR_DIR="${DEV_EDITOR_DIR:-$DEV_ROOT}"
  DEV_EDITOR_CMD="${DEV_EDITOR_CMD:-croft}"
  DEV_EDITOR_SESSION="${DEV_EDITOR_SESSION:-$DEV_NAME-editor}"
  DEV_REVIEW_CMD="${DEV_REVIEW_CMD-gh dash}"
  DEV_REVIEW_SUB_CMD="${DEV_REVIEW_SUB_CMD-}"
  DEV_REVIEW_SUB_LINES="${DEV_REVIEW_SUB_LINES:-5}"
  DEV_GH_COLS="${DEV_GH_COLS:-76}"
  DEV_BOTTOM_LINES="${DEV_BOTTOM_LINES:-14}"
  # Swappable pane: the leftmost top pane cycles through editor (croft),
  # review (lumen) and docs (mdpick/mdcat). The non-visible modes live in a
  # detached pool window so they stay alive across switches.
  DEV_SWAP_DEFAULT="${DEV_SWAP_DEFAULT:-editor}"
  DEV_SWAP_REVIEW_CMD="${DEV_SWAP_REVIEW_CMD:-lumen diff}"
  DEV_SWAP_DOCS_CMD="${DEV_SWAP_DOCS_CMD:-dev-docs}"
  DEV_SWAP_POOL_WINDOW="${DEV_SWAP_POOL_WINDOW:-_pool}"
  declare -p DEV_TERM_DIRS >/dev/null 2>&1 || DEV_TERM_DIRS=("$DEV_ROOT")
  DEV_TERM_PATHS=()
  local d
  for d in "${DEV_TERM_DIRS[@]}"; do
    case "$d" in
      /*) DEV_TERM_PATHS+=("$d") ;;
      *) DEV_TERM_PATHS+=("$DEV_ROOT/$d") ;;
    esac
  done
  # Optional per-pane commands, parallel to DEV_TERM_DIRS. Empty entries just
  # leave a shell. Profiles set e.g. a live actions view in one bottom pane.
  declare -p DEV_TERM_CMDS >/dev/null 2>&1 || {
    DEV_TERM_CMDS=()
    local c
    for c in "${DEV_TERM_PATHS[@]}"; do DEV_TERM_CMDS+=(""); done
  }
}

load_profile() {
  local name="$1" file
  reset_profile
  file="$DEV_CONFIG_DIR/$name.conf"
  if [ -f "$file" ]; then
    # shellcheck disable=SC1090
    . "$file"
  fi
  apply_defaults
}

all_profiles() {
  local f
  for f in "$DEV_CONFIG_DIR"/*.conf; do
    [ -f "$f" ] || continue
    basename "$f" .conf
  done
}

# --- session builders -------------------------------------------------------

build_agent() {
  [ -n "$DEV_AGENT_CMD" ] || return 0
  have "$DEV_AGENT_SESSION" && return 0
  local pane i
  pane=$("$TMUX_BIN" new-session -d -s "$DEV_AGENT_SESSION" -n agent -c "$DEV_AGENT_DIR" -P -F '#{pane_id}')
  "$TMUX_BIN" set-option -p -t "$pane" @dev_agent_started 1
  i=1
  while [ "$i" -lt "$DEV_AGENT_PANES" ]; do
    pane=$("$TMUX_BIN" split-window -h -t "$pane" -c "$DEV_AGENT_DIR" -P -F '#{pane_id}')
    "$TMUX_BIN" set-option -p -t "$pane" @dev_agent_started 1
    i=$((i + 1))
  done
  while IFS= read -r pane; do
    "$TMUX_BIN" send-keys -t "$pane" "$DEV_AGENT_CMD" Enter
  done < <("$TMUX_BIN" list-panes -t "$DEV_AGENT_SESSION" -F '#{pane_id}')
}

build_editor() {
  have "$DEV_EDITOR_SESSION" && return 0
  local top bottom top_right review_sub n j pane
  local -a bottom_panes=()
  top=$("$TMUX_BIN" new-session -d -s "$DEV_EDITOR_SESSION" -n editor -c "$DEV_EDITOR_DIR" -P -F '#{pane_id}')

  # bottom strip: one pane per terminal dir
  n=${#DEV_TERM_PATHS[@]}
  if [ "$n" -gt 0 ]; then
    bottom=$("$TMUX_BIN" split-window -v -t "$top" -l "$DEV_BOTTOM_LINES" -c "${DEV_TERM_PATHS[0]}" -P -F '#{pane_id}')
    bottom_panes+=("$bottom")
    j=1
    while [ "$j" -lt "$n" ]; do
      bottom=$("$TMUX_BIN" split-window -h -t "$bottom" -l 50% -c "${DEV_TERM_PATHS[$j]}" -P -F '#{pane_id}')
      bottom_panes+=("$bottom")
      j=$((j + 1))
    done
  fi

  # review pane on the right of the top row
  top_right=""
  if [ -n "$DEV_REVIEW_CMD" ]; then
    top_right=$("$TMUX_BIN" split-window -h -t "$top" -l "$DEV_GH_COLS" -c "$DEV_EDITOR_DIR" -P -F '#{pane_id}')
  fi

  # optional pane directly below the review pane (e.g. a live actions readout)
  review_sub=""
  if [ -n "$top_right" ] && [ -n "$DEV_REVIEW_SUB_CMD" ]; then
    review_sub=$("$TMUX_BIN" split-window -v -t "$top_right" -l "$DEV_REVIEW_SUB_LINES" -c "$DEV_EDITOR_DIR" -P -F '#{pane_id}')
  fi

  "$TMUX_BIN" send-keys -t "$top" "$DEV_EDITOR_CMD" Enter
  if [ -n "$top_right" ]; then
    "$TMUX_BIN" send-keys -t "$top_right" "$DEV_REVIEW_CMD" Enter
  fi
  if [ -n "$review_sub" ]; then
    "$TMUX_BIN" send-keys -t "$review_sub" "$DEV_REVIEW_SUB_CMD" Enter
    "$TMUX_BIN" set-option -p -t "$review_sub" @dev_review_sub_started 1
  fi
  j=0
  if [ "${#bottom_panes[@]}" -gt 0 ]; then
    for pane in "${bottom_panes[@]}"; do
      if [ -n "${DEV_TERM_CMDS[$j]:-}" ]; then
        "$TMUX_BIN" send-keys -t "$pane" "${DEV_TERM_CMDS[$j]}" Enter
        "$TMUX_BIN" set-option -p -t "$pane" @dev_term_started 1
      fi
      j=$((j + 1))
    done
  fi

  # Swap pane: the leftmost top pane is the visible slot (croft by default);
  # the other modes live in a detached pool window so they stay alive.
  build_swap_pool "$top"
}

build() { build_agent; build_editor; }

# --- ensure -----------------------------------------------------------------

latest_save() {
  ls -t "$RESURRECT_DIR"/tmux_resurrect_*.txt 2>/dev/null | head -n1
}

# Restore the last resurrect save, synchronously, into the running server.
restore_from_save() {
  local socket
  socket=$("$TMUX_BIN" display-message -p '#{socket_path}' 2>/dev/null || true)
  [ -n "$socket" ] || return 1
  [ -n "$(latest_save)" ] || return 1
  TMUX="$socket,0,0" bash "$RESURRECT_RESTORE" >/dev/null 2>&1 || true
}

# Start the agent in any agent pane sitting at a plain shell. A pane option
# marks a pane as already handled so ensure and the resurrect hook can both
# call this without starting the agent twice.
start_agent_in_shells() {
  [ -n "$DEV_AGENT_CMD" ] || return 0
  have "$DEV_AGENT_SESSION" || return 0
  local pane cmd mark
  while IFS= read -r pane; do
    mark=$("$TMUX_BIN" show-options -p -t "$pane" -qv @dev_agent_started 2>/dev/null || true)
    [ "$mark" = "1" ] && continue
    cmd=$("$TMUX_BIN" display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null || echo '')
    case "$cmd" in
      zsh|bash|sh|-zsh|-bash)
        "$TMUX_BIN" set-option -p -t "$pane" @dev_agent_started 1
        "$TMUX_BIN" send-keys -t "$pane" "$DEV_AGENT_CMD" Enter
        ;;
    esac
  done < <("$TMUX_BIN" list-panes -t "$DEV_AGENT_SESSION" -F '#{pane_id}' 2>/dev/null)
}

# Send a command to a pane only if it is sitting at a plain shell.
send_if_shell() {
  local pane="$1" command="$2" cur
  [ -n "$command" ] || return 0
  cur=$("$TMUX_BIN" display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null || echo '')
  case "$cur" in
    zsh|bash|sh|-zsh|-bash) "$TMUX_BIN" send-keys -t "$pane" "$command" Enter ;;
  esac
}

# Restart the editor and review commands in a restored editor session. resurrect
# cannot restore commands with arguments (the review pane uses a per-profile
# `gh dash --config`), so it leaves those panes as shells and this fills them in.
start_views_in_shells() {
  have "$DEV_EDITOR_SESSION" || return 0
  local panes top_min top_sorted editor review
  panes=$("$TMUX_BIN" list-panes -t "${DEV_EDITOR_SESSION}:editor" -F '#{pane_id} #{pane_top} #{pane_left}' 2>/dev/null) || return 0
  [ -n "$panes" ] || return 0
  top_min=$(printf '%s\n' "$panes" | awk '{ print $2 }' | sort -n | head -n1)
  top_sorted=$(printf '%s\n' "$panes" | awk -v t="$top_min" '$2 == t { print $3, $1 }' | sort -n)
  editor=$(printf '%s\n' "$top_sorted" | head -n1 | awk '{ print $2 }')
  review=$(printf '%s\n' "$top_sorted" | tail -n1 | awk '{ print $2 }')
  send_if_shell "$editor" "$DEV_EDITOR_CMD"
  if [ "$review" != "$editor" ]; then
    send_if_shell "$review" "$DEV_REVIEW_CMD"
  fi
  # Restart the pane below the review pane, identified by geometry.
  if [ -n "$DEV_REVIEW_SUB_CMD" ] && [ -n "$review" ] && [ "$review" != "$editor" ]; then
    local review_left sub mark
    review_left=$(printf '%s\n' "$top_sorted" | tail -n1 | awk '{ print $1 }')
    sub=$(printf '%s\n' "$panes" | awk -v l="$review_left" -v t="$top_min" '$3 == l && $2 > t { print $2, $1 }' | sort -n | head -n1 | awk '{ print $2 }')
    if [ -n "$sub" ]; then
      mark=$("$TMUX_BIN" show-options -p -t "$sub" -qv @dev_review_sub_started 2>/dev/null || true)
      if [ "$mark" != "1" ]; then
        send_if_shell "$sub" "$DEV_REVIEW_SUB_CMD"
        "$TMUX_BIN" set-option -p -t "$sub" @dev_review_sub_started 1
      fi
    fi
  fi
  # Restart bottom-strip commands (left to right) that resurrect left as shells.
  # Commands are positional, so only act when the restored bottom row matches
  # the profile; a resurrected older layout with a different pane count would
  # otherwise misassign them.
  if [ "${#DEV_TERM_CMDS[@]}" -gt 0 ]; then
    local bottom_count
    bottom_count=$(printf '%s\n' "$panes" | awk -v t="$top_min" '$2 > t' | wc -l | tr -d ' ')
    if [ "$bottom_count" -eq "${#DEV_TERM_CMDS[@]}" ]; then
      local i=0 bottom_pane mark cmd
      while IFS= read -r bottom_pane; do
        cmd="${DEV_TERM_CMDS[$i]:-}"
        if [ -n "$cmd" ]; then
          mark=$("$TMUX_BIN" show-options -p -t "$bottom_pane" -qv @dev_term_started 2>/dev/null || true)
          if [ "$mark" != "1" ]; then
            send_if_shell "$bottom_pane" "$cmd"
            "$TMUX_BIN" set-option -p -t "$bottom_pane" @dev_term_started 1
          fi
        fi
        i=$((i + 1))
      done < <(printf '%s\n' "$panes" | awk -v t="$top_min" '$2 > t { print $3, $1 }' | sort -n | awk '{ print $2 }')
    fi
  fi
}

# Bring the review pane back without disturbing anything else. Idempotent:
# - review command already running: no-op
# - pane fell back to a shell after the TUI quit: relaunch the command
# - pane was killed: split it back off the editor pane, then re-pin the layout
ensure_review_pane() {
  [ -n "$DEV_REVIEW_CMD" ] || return 0
  have "$DEV_EDITOR_SESSION" || return 0
  local panes top_min top_sorted editor review recreated=0
  panes=$("$TMUX_BIN" list-panes -t "${DEV_EDITOR_SESSION}:editor" -F '#{pane_id} #{pane_top} #{pane_left}' 2>/dev/null) || return 0
  [ -n "$panes" ] || return 0
  top_min=$(printf '%s\n' "$panes" | awk '{ print $2 }' | sort -n | head -n1)
  top_sorted=$(printf '%s\n' "$panes" | awk -v t="$top_min" '$2 == t { print $3, $1 }' | sort -n)
  editor=$(printf '%s\n' "$top_sorted" | head -n1 | awk '{ print $2 }')
  review=$(printf '%s\n' "$top_sorted" | tail -n1 | awk '{ print $2 }')
  if [ "$review" = "$editor" ]; then
    review=$("$TMUX_BIN" split-window -h -t "$editor" -l "$DEV_GH_COLS" -c "$DEV_EDITOR_DIR" -P -F '#{pane_id}')
    recreated=1
  elif [ "$("$TMUX_BIN" show-options -p -t "$review" -qv @dev_review_sub_started 2>/dev/null || true)" = "1" ]; then
    # The rightmost top pane is the review-sub pane, so the review pane was
    # killed and the sub pane expanded into its place. Recreate the review pane
    # above the sub pane, keeping the two stacked in the right column.
    review=$("$TMUX_BIN" split-window -v -b -t "$review" -c "$DEV_EDITOR_DIR" -P -F '#{pane_id}')
    recreated=1
  fi
  send_if_shell "$review" "$DEV_REVIEW_CMD"
  [ "$recreated" = "1" ] && normalize_editor
  return 0
}

# Re-apply the editor window's fixed layout. tmux-resurrect restores the layout
# it saved and drops pane options, so a restart would otherwise bring back old
# sizes.
normalize_editor() {
  have "$DEV_EDITOR_SESSION" || return 0
  local panes top_min bot_max top_sorted editor review bottom review_left review_sub
  panes=$("$TMUX_BIN" list-panes -t "${DEV_EDITOR_SESSION}:editor" -F '#{pane_id} #{pane_top} #{pane_left}' 2>/dev/null) || return 0
  [ -n "$panes" ] || return 0

  top_min=$(printf '%s\n' "$panes" | awk '{ print $2 }' | sort -n | head -n1)
  bot_max=$(printf '%s\n' "$panes" | awk '{ print $2 }' | sort -n | tail -n1)
  top_sorted=$(printf '%s\n' "$panes" | awk -v t="$top_min" '$2 == t { print $3, $1 }' | sort -n)
  editor=$(printf '%s\n' "$top_sorted" | head -n1 | awk '{ print $2 }')
  review=$(printf '%s\n' "$top_sorted" | tail -n1 | awk '{ print $2 }')
  if [ "$review" = "$editor" ]; then review=""; fi
  bottom=$(printf '%s\n' "$panes" | awk -v t="$bot_max" '$2 == t { print $3, $1 }' | sort -n | head -n1 | awk '{ print $2 }')

  if [ -n "$review" ]; then
    "$TMUX_BIN" resize-pane -t "$review" -x "$DEV_GH_COLS" 2>/dev/null || true
    review_left=$(printf '%s\n' "$top_sorted" | tail -n1 | awk '{ print $1 }')
    review_sub=$(printf '%s\n' "$panes" | awk -v l="$review_left" -v t="$top_min" '$3 == l && $2 > t { print $2, $1 }' | sort -n | head -n1 | awk '{ print $2 }')
    if [ -n "$review_sub" ]; then
      "$TMUX_BIN" resize-pane -t "$review_sub" -y "$DEV_REVIEW_SUB_LINES" 2>/dev/null || true
    fi
  fi
  if [ -n "$bottom" ]; then
    "$TMUX_BIN" resize-pane -t "$bottom" -y "$DEV_BOTTOM_LINES" 2>/dev/null || true
  fi
  return 0
}

normalize_editor_all() {
  local name
  for name in $(all_profiles) "$DEFAULT_PROFILE"; do
    load_profile "$name"
    normalize_editor
  done
}

# Debounced for the window-resized hook: a drag emits many resize events, so
# only the last one in a burst re-applies the layout.
normalize_editor_all_debounced() {
  local stamp="/tmp/dev-workspace.normalize" mine
  mine="$(date +%s).$$.$RANDOM"
  printf '%s' "$mine" > "$stamp" 2>/dev/null || return 0
  sleep 0.25
  [ "$(cat "$stamp" 2>/dev/null || true)" = "$mine" ] || return 0
  normalize_editor_all
}

# --- swap pane tabs ---------------------------------------------------------
#
# The leftmost top pane of the editor window is a swap slot; the other modes
# live in a detached pool window in the same session so they stay alive. Pane
# options: @dev_swap=1 on every mode pane, @dev_swap_mode=editor|review|docs,
# @dev_swap_cmd=<command> (for respawn), @dev_swap_visible=1 on the one shown.

swap_status_format() {
  local active="$1" out="" name label i=0 sep
  # tmux-nova separators/colours so the tabs match the rest of the status bar:
  # the active tab is an orange angled segment, inactive tabs blend into the
  # black bar. sep is U+E0B8, the same glyph as @nova-nerdfonts-left (octal so
  # this works on bash 3.2).
  sep=$(printf '\356\202\270')
  for name in editor review docs; do
    case "$name" in
      editor) label=edit ;;
      review) label=review ;;
      docs)   label=docs ;;
    esac
    i=$((i + 1))
    if [ "$name" = "$active" ]; then
      out="${out}#[fg=#000000,bg=#ffa827]${sep}#[fg=#000000]#[bg=#ffa827] ${i} ${label} #[fg=#ffa827,bg=#000000]${sep}"
    else
      out="${out}#[fg=#cfcfc2,bg=#000000] ${i} ${label} "
    fi
  done
  printf '%s' "$out"
}

set_swap_status() {
  local active="$1" session="$2" fmt
  fmt="$(swap_status_format "$active")"
  "$TMUX_BIN" set-window-option -t "${session}:editor" window-status-format "$fmt" 2>/dev/null || true
  "$TMUX_BIN" set-window-option -t "${session}:editor" window-status-current-format "$fmt" 2>/dev/null || true
  "$TMUX_BIN" refresh-client -S 2>/dev/null || true
}

hide_pool_window() {
  local session="$1"
  local win="${session}:${DEV_SWAP_POOL_WINDOW}"
  "$TMUX_BIN" set-window-option -t "$win" window-status-format '' 2>/dev/null || true
  "$TMUX_BIN" set-window-option -t "$win" window-status-current-format '' 2>/dev/null || true
}

swap_pane_option() {
  # swap_pane_option <pane> <mode> <cmd> <visible 0|1>
  local pane="$1" mode="$2" cmd="$3" vis="${4:-0}"
  "$TMUX_BIN" set-option -p -t "$pane" @dev_swap 1 2>/dev/null || true
  "$TMUX_BIN" set-option -p -t "$pane" @dev_swap_mode "$mode" 2>/dev/null || true
  "$TMUX_BIN" set-option -p -t "$pane" @dev_swap_cmd "$cmd" 2>/dev/null || true
  if [ "$vis" = "1" ]; then
    "$TMUX_BIN" set-option -p -t "$pane" @dev_swap_visible 1 2>/dev/null || true
  else
    "$TMUX_BIN" set-option -p -u -t "$pane" @dev_swap_visible 2>/dev/null || true
  fi
}

build_swap_pool() {
  # $1 is the visible editor pane, already running DEV_EDITOR_CMD.
  have "$DEV_EDITOR_SESSION" || return 0
  local slot="$1" pool review docs
  swap_pane_option "$slot" editor "$DEV_EDITOR_CMD" 1

  pool=$("$TMUX_BIN" new-window -d -t "$DEV_EDITOR_SESSION" -n "$DEV_SWAP_POOL_WINDOW" \
    -c "$DEV_EDITOR_DIR" -P -F '#{pane_id}' 2>/dev/null) || return 0
  # Keep quit apps as dead panes instead of letting tmux close them, so the tab
  # layout survives and swap_to can respawn them.
  "$TMUX_BIN" set-window-option -t "${DEV_EDITOR_SESSION}:${DEV_SWAP_POOL_WINDOW}" remain-on-exit on 2>/dev/null || true
  review="$pool"
  docs=$("$TMUX_BIN" split-window -h -t "$review" -c "$DEV_EDITOR_DIR" -P -F '#{pane_id}' 2>/dev/null) || docs=""
  "$TMUX_BIN" send-keys -t "$review" "$DEV_SWAP_REVIEW_CMD" Enter 2>/dev/null || true
  swap_pane_option "$review" review "$DEV_SWAP_REVIEW_CMD" 0
  if [ -n "$docs" ]; then
    "$TMUX_BIN" send-keys -t "$docs" "$DEV_SWAP_DOCS_CMD" Enter 2>/dev/null || true
    swap_pane_option "$docs" docs "$DEV_SWAP_DOCS_CMD" 0
  fi
  hide_pool_window "$DEV_EDITOR_SESSION"
  set_swap_status editor "$DEV_EDITOR_SESSION"
  if [ "$DEV_SWAP_DEFAULT" != "editor" ]; then
    swap_to "$DEV_SWAP_DEFAULT" "$DEV_EDITOR_SESSION" || true
  fi
}

swap_respawn_if_dead() {
  local pane="$1" cmd
  [ "$("$TMUX_BIN" display-message -p -t "$pane" '#{pane_dead}' 2>/dev/null || echo 0)" = "1" ] || return 0
  cmd=$("$TMUX_BIN" show-options -p -t "$pane" -qv @dev_swap_cmd 2>/dev/null || true)
  [ -n "$cmd" ] || return 0
  "$TMUX_BIN" respawn-pane -k -t "$pane" "$cmd" 2>/dev/null || true
}

swap_to() {
  local mode="$1" session="${2:-}" target visible
  [ -n "$session" ] || session=$("$TMUX_BIN" display-message -p '#S' 2>/dev/null || true)
  [ -n "$session" ] || return 0
  target=$("$TMUX_BIN" list-panes -s -t "$session" -F '#{pane_id} #{@dev_swap_mode}' 2>/dev/null \
    | awk -v m="$mode" '$2 == m { print $1; exit }')
  [ -n "$target" ] || { printf 'dev-workspace: no swap pane for %s\n' "$mode" >&2; return 1; }
  swap_respawn_if_dead "$target"
  visible=$("$TMUX_BIN" list-panes -s -t "$session" -F '#{pane_id} #{@dev_swap_visible}' 2>/dev/null \
    | awk '$2 == 1 { print $1; exit }')
  if [ "$target" = "$visible" ]; then
    set_swap_status "$mode" "$session"
    "$TMUX_BIN" select-pane -t "$target" 2>/dev/null || true
    return 0
  fi
  [ -n "$visible" ] || { printf 'dev-workspace: no visible swap pane\n' >&2; return 1; }
  "$TMUX_BIN" swap-pane -s "$target" -t "$visible" 2>/dev/null || return 1
  "$TMUX_BIN" set-option -p -u -t "$visible" @dev_swap_visible 2>/dev/null || true
  "$TMUX_BIN" set-option -p -t "$target" @dev_swap_visible 1 2>/dev/null || true
  "$TMUX_BIN" select-window -t "${session}:editor" 2>/dev/null || true
  "$TMUX_BIN" select-pane -t "$target" 2>/dev/null || true
  set_swap_status "$mode" "$session"
}

swap_cycle() {
  local dir="$1" session="${2:-}" active next prev
  [ -n "$session" ] || session=$("$TMUX_BIN" display-message -p '#S' 2>/dev/null || true)
  [ -n "$session" ] || return 0
  # A session with no swap pane (the agent view next door) has nothing to
  # cycle: Ctrl+Tab there is a no-op, not a "no swap pane for review" error.
  if ! "$TMUX_BIN" list-panes -s -t "$session" -F '#{@dev_swap}' 2>/dev/null | grep -qx 1; then
    return 0
  fi
  active=$("$TMUX_BIN" list-panes -s -t "$session" -F '#{@dev_swap_mode} #{@dev_swap_visible}' 2>/dev/null \
    | awk '$2 == 1 { print $1; exit }')
  case "$active" in
    editor) next=review; prev=docs ;;
    review) next=docs;   prev=editor ;;
    docs)   next=editor; prev=review ;;
    *)      next=review; prev=docs ;;
  esac
  if [ "$dir" = "prev" ]; then swap_to "$prev" "$session"; else swap_to "$next" "$session"; fi
}

swap_cmd() {
  local mode="${1:-next}" session=""
  shift 2>/dev/null || true
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --session) session="${2:-}"; shift 2 ;;
      *)         shift ;;
    esac
  done
  case "$mode" in
    next|prev) swap_cycle "$mode" "$session" ;;
    editor|review|docs) swap_to "$mode" "$session" ;;
    *) echo "usage: dev-workspace swap [next|prev|editor|review|docs] [--session NAME]" >&2; return 1 ;;
  esac
}

open_review() {
  local session="" path="" repo="" pr=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --session) session="${2:-}"; shift 2 ;;
      --path)    path="${2:-}"; shift 2 ;;
      --repo)    repo="${2:-}"; shift 2 ;;
      --pr)      pr="${2:-}"; shift 2 ;;
      *)         shift ;;
    esac
  done
  [ -n "$session" ] || session=$("$TMUX_BIN" display-message -p '#S' 2>/dev/null || true)
  [ -n "$session" ] || return 0
  [ -n "$pr" ] || { echo "dev-workspace open-review: --pr is required" >&2; return 1; }
  local review cmd
  review=$("$TMUX_BIN" list-panes -s -t "$session" -F '#{pane_id} #{@dev_swap_mode}' 2>/dev/null \
    | awk '$2 == "review" { print $1; exit }')
  [ -n "$review" ] || { echo "dev-workspace open-review: no review pane" >&2; return 1; }
  cmd="lumen diff --pr $pr"
  if [ -n "$repo" ]; then
    cmd="$cmd --origin $repo"
  fi
  if [ -n "$path" ] && [ -d "$path" ]; then
    cmd="cd $(printf '%q' "$path") && $cmd"
  fi
  # Leave @dev_swap_cmd at the review default (the repo picker) so quitting the
  # PR returns to the picker instead of reloading the PR.
  "$TMUX_BIN" respawn-pane -k -t "$review" "$cmd" 2>/dev/null || return 1
  swap_to review "$session"
}

# --- open-file picker -------------------------------------------------------
#
# Cmd+O from any pane: fzf a file under ~/Projects in a tmux popup, then hand
# the absolute path to the croft hosting the editor session through the
# CROFT_VIEW_SOCK it publishes. The popup gives fzf a tty; the outer command
# resolves the socket so the picker works from the agent session too.

find_croft_session() {
  local current="$1" s name
  # Prefer the editor session of the profile that owns the invoking pane, so
  # two open workspaces do not open the file in each other's croft.
  if [ -n "$current" ]; then
    for name in $(all_profiles) "$DEFAULT_PROFILE"; do
      load_profile "$name"
      if [ "$DEV_AGENT_SESSION" = "$current" ] || [ "$DEV_EDITOR_SESSION" = "$current" ]; then
        printf '%s' "$DEV_EDITOR_SESSION"; return 0
      fi
    done
  fi
  # Otherwise take the session that owns a swappable croft editor pane.
  s=$("$TMUX_BIN" list-panes -a -F '#{session_name} #{@dev_swap}' 2>/dev/null \
    | awk '$2 == 1 { print $1; exit }')
  [ -n "$s" ] && { printf '%s' "$s"; return 0; }
  # Fall back to a session that published CROFT_VIEW_SOCK.
  for s in $("$TMUX_BIN" list-sessions -F '#{session_name}' 2>/dev/null); do
    if "$TMUX_BIN" show-environment -t "$s" CROFT_VIEW_SOCK >/dev/null 2>&1; then
      printf '%s' "$s"; return 0
    fi
  done
  printf '%s' "$current"
}

open_file_pick() {
  local root="$1" sel
  [ -d "$root" ] || return 0
  sel=$(
    if command -v rg >/dev/null 2>&1; then
      rg --files --hidden -g '!.git' -g '!node_modules' -g '!target' "$root" 2>/dev/null
    elif command -v fd >/dev/null 2>&1; then
      fd --type f --hidden --exclude .git --exclude node_modules --exclude target . "$root" 2>/dev/null
    else
      find "$root" -type f -not -path '*/.git/*' -not -path '*/node_modules/*' 2>/dev/null
    fi \
    | fzf \
      --prompt='open> ' \
      --reverse \
      --no-multi \
      --preview='bat --style=numbers --color=always --line-range=:300 -- {} 2>/dev/null || sed -n "1,300p" {}' \
      --preview-window='right:60%,border-left' || true
  )
  [ -n "$sel" ] || return 0
  if [ -n "${CROFT_VIEW_SOCK:-}" ]; then
    croft edit "$sel" >/dev/null 2>&1 || true
  fi
}

open_file() {
  local session="" root="" pick=0 editor sock
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --session) session="${2:-}"; shift 2 ;;
      --root)    root="${2:-}"; shift 2 ;;
      --pick)    pick=1; shift ;;
      *)         shift ;;
    esac
  done
  [ -n "$root" ] || root="${DEV_ROOT:-$HOME/Projects}"
  if [ "$pick" = 1 ]; then
    open_file_pick "$root"
    return $?
  fi
  editor=$(find_croft_session "$session")
  [ -n "$editor" ] || return 0
  sock=$("$TMUX_BIN" show-environment -t "$editor" CROFT_VIEW_SOCK 2>/dev/null \
    | sed -n 's/^CROFT_VIEW_SOCK=//p')
  [ -n "$sock" ] || return 0
  "$TMUX_BIN" display-popup -E -w 90% -h 80% -T ' open file ' \
    "CROFT_VIEW_SOCK='$sock' '$DEV_SELF' open-file --pick --root '$root'" 2>/dev/null || true
  swap_to editor "$editor" >/dev/null 2>&1 || true
}

rebuild_swap() {
  have "$DEV_EDITOR_SESSION" || return 0
  local win="${DEV_EDITOR_SESSION}:editor"
  local panes top_min slot
  panes=$("$TMUX_BIN" list-panes -t "$win" -F '#{pane_id} #{pane_top} #{pane_left}' 2>/dev/null) || return 0
  [ -n "$panes" ] || return 0
  top_min=$(printf '%s\n' "$panes" | awk '{ print $2 }' | sort -n | head -n1)
  slot=$(printf '%s\n' "$panes" | awk -v t="$top_min" '$2 == t { print $3, $1 }' | sort -n | head -n1 | awk '{ print $2 }')
  [ -n "$slot" ] || return 0
  # Idempotent: if the slot is already a swap pane and the pool exists, leave
  # everything (and its live processes) alone. This lets `ensure` heal older
  # workspaces built before the swap pane existed without restarting on every
  # open.
  if [ "$("$TMUX_BIN" show-options -p -t "$slot" -qv @dev_swap 2>/dev/null || true)" = "1" ] \
    && "$TMUX_BIN" list-windows -t "$DEV_EDITOR_SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$DEV_SWAP_POOL_WINDOW"; then
    return 0
  fi
  if "$TMUX_BIN" list-windows -t "$DEV_EDITOR_SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$DEV_SWAP_POOL_WINDOW"; then
    "$TMUX_BIN" kill-window -t "${DEV_EDITOR_SESSION}:${DEV_SWAP_POOL_WINDOW}" 2>/dev/null || true
  fi
  build_swap_pool "$slot"
}

ensure_unlocked() {
  "$TMUX_BIN" start-server 2>/dev/null || true
  local missing=0
  if [ -n "$DEV_AGENT_CMD" ] && ! have "$DEV_AGENT_SESSION"; then missing=1; fi
  if ! have "$DEV_EDITOR_SESSION"; then missing=1; fi
  if [ "$missing" = "1" ] && [ -n "$(latest_save)" ]; then
    # Keep the server alive while restoring from scratch.
    local tmp="__dev_workspace_${DEV_NAME}_tmp__"
    if ! have "$tmp"; then
      "$TMUX_BIN" new-session -d -s "$tmp" -c "$DEV_ROOT" 2>/dev/null || true
    fi
    restore_from_save
    if have "$tmp"; then
      "$TMUX_BIN" kill-session -t "$tmp" 2>/dev/null || true
    fi
    # resurrect restores the agent as a generic process, so it comes back as a
    # shell; start it again.
    sleep 1
    start_agent_in_shells
    start_views_in_shells
    rebuild_swap
  fi
  build
  normalize_editor
  rebuild_swap
}

ensure() {
  local lockdir="/tmp/dev-workspace-${DEV_NAME}.lock"
  while ! mkdir "$lockdir" 2>/dev/null; do sleep 0.2; done
  trap 'rmdir "$lockdir" 2>/dev/null || true' EXIT
  ensure_unlocked
  rmdir "$lockdir" 2>/dev/null || true
  trap - EXIT
}

# --- actions ----------------------------------------------------------------

attach() {
  local session="${1:-$DEV_EDITOR_SESSION}"
  ensure
  "$TMUX_BIN" attach-session -t "$session"
}

attach_only() {
  "$TMUX_BIN" attach-session -t "${1:-$DEV_EDITOR_SESSION}"
}

# Create one Ghostty window attached to a session, inside the existing Ghostty
# app instance. Ghostty runs a multiple-argument `command` through /bin/sh -c.
new_ghostty_window() {
  local session="$1" cmd
  if [ "$PROFILE" = "$DEFAULT_PROFILE" ]; then
    cmd="$DEV_SELF attach-only $session"
  else
    cmd="$DEV_SELF $PROFILE attach-only $session"
  fi
  osascript - "$cmd" <<'APPLESCRIPT'
on run argv
  set cmd to item 1 of argv
  tell application "Ghostty"
    set cfg to new surface configuration
    set command of cfg to cmd
    new window with configuration cfg
  end tell
end run
APPLESCRIPT
}

# Focus the Ghostty window backing each session. `open -a` alone only raises
# windows already on the active space, so find each window by its session-name
# title (tmux set-titles-string '#S') and let yabai switch the display to the
# window's space, including a native fullscreen space.
focus_workspace_windows() {
  local title id sessions=()
  if [ -n "$DEV_AGENT_CMD" ]; then sessions+=("$DEV_AGENT_SESSION"); fi
  sessions+=("$DEV_EDITOR_SESSION")
  for title in "${sessions[@]}"; do
    id=$(yabai -m query --windows 2>/dev/null \
      | jq -r --arg t "$title" '.[] | select(.app=="Ghostty" and .title==$t) | .id' \
      | head -n1)
    if [ -n "$id" ]; then
      yabai -m window --focus "$id" 2>/dev/null || true
    fi
  done
  /usr/bin/open -a /Applications/Ghostty.app
}

open_windows() {
  ensure

  local agent_open=1 editor_open=1
  if [ -n "$DEV_AGENT_CMD" ] && ! have_client "$DEV_AGENT_SESSION"; then agent_open=0; fi
  if ! have_client "$DEV_EDITOR_SESSION"; then editor_open=0; fi

  # Already open: swap to each window's space and focus the app; spawn nothing.
  if [ "$agent_open" = "1" ] && [ "$editor_open" = "1" ]; then
    focus_workspace_windows
    return 0
  fi

  # Start a single windowless app instance if Ghostty is not already running.
  # (`--initial-window=false` is only applied on this fresh launch, so a normal
  # double-click launch still opens a window.)
  if ! pgrep -x ghostty >/dev/null 2>&1; then
    /usr/bin/open -a /Applications/Ghostty.app --args --initial-window=false
    local i
    for i in $(seq 1 50); do
      osascript -e 'tell application "Ghostty" to count windows' >/dev/null 2>&1 && break
      sleep 0.1
    done
  fi

  # Create only the windows whose session has no attached client.
  if [ -n "$DEV_AGENT_CMD" ] && [ "$agent_open" = "0" ]; then
    new_ghostty_window "$DEV_AGENT_SESSION"
  fi
  if [ "$editor_open" = "0" ]; then
    new_ghostty_window "$DEV_EDITOR_SESSION"
  fi
}

# Resolve the profile that owns tmux session $1 (a workspace's agent or editor
# session). Prints the profile name, or nothing when none matches.
profile_for_session() {
  local current="$1" name
  for name in "$DEFAULT_PROFILE" $(all_profiles); do
    load_profile "$name"
    if [ "$DEV_AGENT_SESSION" = "$current" ] || [ "$DEV_EDITOR_SESSION" = "$current" ]; then
      printf '%s' "$name"
      return 0
    fi
  done
  return 1
}

# Reset one workspace (both sessions of the loaded profile): kill the sessions,
# then rebuild and reopen each Ghostty window. A keepalive session stays up
# across the kill so the tmux server (and this background script) survives when
# the last real session goes away.
restart_profile() {
  local keepalive="__dev_workspace_restart__"
  have "$keepalive" || "$TMUX_BIN" new-session -d -s "$keepalive" -c "$DEV_ROOT" 2>/dev/null || true
  if have "$DEV_EDITOR_SESSION"; then
    "$TMUX_BIN" kill-session -t "$DEV_EDITOR_SESSION" 2>/dev/null || true
  fi
  if have "$DEV_AGENT_SESSION"; then
    "$TMUX_BIN" kill-session -t "$DEV_AGENT_SESSION" 2>/dev/null || true
  fi
  sleep 0.3
  open_windows
  if have "$DEV_EDITOR_SESSION"; then
    "$TMUX_BIN" kill-session -t "$keepalive" 2>/dev/null || true
  fi
}

# Reset the current workspace (prefix R) or every profile (--all). The binding
# passes `--session '#{session_name}'` so the profile is resolved from the pane
# the key was pressed in; without a match the default profile is used.
restart() {
  local session="" all=0 name resolved=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --session) session="${2:-}"; shift 2 ;;
      --all)     all=1; shift ;;
      *)         shift ;;
    esac
  done
  if [ "$all" = "1" ]; then
    local -a names=("$DEFAULT_PROFILE")
    for name in $(all_profiles); do
      [ "$name" = "$DEFAULT_PROFILE" ] && continue
      names+=("$name")
    done
    for name in "${names[@]}"; do
      PROFILE="$name"
      load_profile "$name"
      restart_profile
    done
    return 0
  fi
  if [ -n "$session" ]; then
    resolved="$(profile_for_session "$session" || true)"
  fi
  if [ -n "$resolved" ]; then
    PROFILE="$resolved"
    load_profile "$resolved"
  else
    load_profile "$PROFILE"
  fi
  restart_profile
}

# Called by tmux-resurrect after a manual restore.
post_restore() {
  sleep 1.5
  start_agent_in_shells
  start_views_in_shells
  normalize_editor
  rebuild_swap
}

post_restore_all() {
  sleep 1.5
  local name
  for name in $(all_profiles) "$DEFAULT_PROFILE"; do
    load_profile "$name"
    start_agent_in_shells
    start_views_in_shells
    normalize_editor
    rebuild_swap
  done
}

# --- dispatch ---------------------------------------------------------------

if [ "$#" -eq 0 ]; then
  PROFILE="$DEFAULT_PROFILE"
  CMD="open"
  REST=()
else
  case "$1" in
    open|build|ensure|attach|attach-only|review-pane|normalize-editor|post-restore|restart|swap|open-review|open-file|list|print-config)
      PROFILE="$DEFAULT_PROFILE"
      CMD="$1"
      REST=("${@:2}")
      ;;
    *)
      PROFILE="$1"
      CMD="${2:-open}"
      REST=("${@:3}")
      ;;
  esac
fi

load_profile "$PROFILE"

case "$CMD" in
  open)        open_windows ;;
  build)       build ;;
  ensure)      ensure ;;
  attach)      attach "${REST[0]:-}" ;;
  attach-only) attach_only "${REST[0]:-}" ;;
  review-pane) ensure_review_pane ;;
  swap)        swap_cmd ${REST[@]+"${REST[@]}"} ;;
  open-review) open_review ${REST[@]+"${REST[@]}"} ;;
  open-file)   open_file ${REST[@]+"${REST[@]}"} ;;
  normalize-editor)
    if [ "${REST[0]:-}" = "--all" ]; then
      normalize_editor_all_debounced
    else
      normalize_editor
    fi
    ;;
  post-restore)
    if [ "${REST[0]:-}" = "--all" ]; then
      post_restore_all
    else
      post_restore
    fi
    ;;
  restart)     restart ${REST[@]+"${REST[@]}"} ;;
  list)
    printf '%s (default)\n' "$DEFAULT_PROFILE"
    all_profiles
    ;;
  print-config)
    printf 'DEV_NAME=%s\n' "$DEV_NAME"
    printf 'DEV_ROOT=%s\n' "$DEV_ROOT"
    printf 'DEV_AGENT_DIR=%s\n' "$DEV_AGENT_DIR"
    printf 'DEV_AGENT_CMD=%s\n' "$DEV_AGENT_CMD"
    printf 'DEV_AGENT_PANES=%s\n' "$DEV_AGENT_PANES"
    printf 'DEV_AGENT_SESSION=%s\n' "$DEV_AGENT_SESSION"
    printf 'DEV_EDITOR_DIR=%s\n' "$DEV_EDITOR_DIR"
    printf 'DEV_EDITOR_CMD=%s\n' "$DEV_EDITOR_CMD"
    printf 'DEV_EDITOR_SESSION=%s\n' "$DEV_EDITOR_SESSION"
    printf 'DEV_REVIEW_CMD=%s\n' "$DEV_REVIEW_CMD"
    printf 'DEV_REVIEW_SUB_CMD=%s\n' "$DEV_REVIEW_SUB_CMD"
    printf 'DEV_REVIEW_SUB_LINES=%s\n' "$DEV_REVIEW_SUB_LINES"
    printf 'DEV_TERM_PATHS=%s\n' "${DEV_TERM_PATHS[*]}"
    printf 'DEV_TERM_CMDS=%s\n' "${DEV_TERM_CMDS[*]}"
    printf 'DEV_GH_COLS=%s\n' "$DEV_GH_COLS"
    printf 'DEV_BOTTOM_LINES=%s\n' "$DEV_BOTTOM_LINES"
    printf 'DEV_SWAP_DEFAULT=%s\n' "$DEV_SWAP_DEFAULT"
    printf 'DEV_SWAP_REVIEW_CMD=%s\n' "$DEV_SWAP_REVIEW_CMD"
    printf 'DEV_SWAP_DOCS_CMD=%s\n' "$DEV_SWAP_DOCS_CMD"
    printf 'DEV_SWAP_POOL_WINDOW=%s\n' "$DEV_SWAP_POOL_WINDOW"
    ;;
  *)
    echo "usage: dev-workspace [<profile>] <command>" >&2
    exit 1
    ;;
esac
