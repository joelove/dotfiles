#!/usr/bin/env bash
#
# running-actions - a live, self-sizing readout of running and recently
# finished GitHub Actions runs across a set of repos, for a dev-workspace pane.
#
# Behaviour:
# - Prints one compact line per run (an n-liner): live (queued or in-progress)
#   runs with a duration that ticks every RUNNING_ACTIONS_TICK seconds (1 by
#   default), plus runs that finished within the last RUNNING_ACTIONS_RECENT
#   seconds (15 min by default). The dot is yellow while live, green on success,
#   red on failure, and dim for other conclusions. Only the newest run per
#   workflow is shown, so a completed row disappears as soon as a newer run for
#   that workflow exists. Each row is an OSC 8 hyperlink to the run, so
#   Cmd+click in Ghostty opens it in the browser (tmux forwards the link via
#   `xterm*:hyperlinks`).
# - Resizes its own tmux pane to n lines (clamped to RUNNING_ACTIONS_MAX_LINES),
#   so the pane it shares vertical space with keeps the rest. At n=0 it collapses
#   to a single empty line, i.e. effectively hidden.
# - Polls the API only every RUNNING_ACTIONS_INTERVAL seconds (30 by default) and
#   uses `gh api --cache` so repeated polls reuse a cached response.
# - Redraws only when the rendered content actually changed (no idle flicker).
#
# Repos default to the Candela set. Override by passing repos as arguments or
# setting RUNNING_ACTIONS_REPOS (space-separated).
#
set -uo pipefail

repos=("$@")
if [ "${#repos[@]}" -eq 0 ]; then
  if [ -n "${RUNNING_ACTIONS_REPOS:-}" ]; then
    read -r -a repos <<<"$RUNNING_ACTIONS_REPOS"
  else
    repos=(
      Candela-Ed/candela-match
      Candela-Ed/candela-eval
      Candela-Ed/candela-orchestrator
      Candela-Ed/candela-infra
      Candela-Ed/candela-cms
    )
  fi
fi
tick="${RUNNING_ACTIONS_TICK:-1}"
interval="${RUNNING_ACTIONS_INTERVAL:-30}"
cache="${RUNNING_ACTIONS_CACHE:-60s}"
maxlines="${RUNNING_ACTIONS_MAX_LINES:-8}"
recent="${RUNNING_ACTIONS_RECENT:-900}"
fetch="${RUNNING_ACTIONS_FETCH:-50}"

pane="${TMUX_PANE:-}"

if [ -t 1 ]; then
  bold=$'\033[1m' dim=$'\033[2m' yellow=$'\033[33m' green=$'\033[32m' red=$'\033[31m' reset=$'\033[0m'
else
  bold="" dim="" yellow="" green="" red="" reset=""
fi

iso_to_epoch() {
  date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$1" +%s 2>/dev/null || printf '0'
}

# Current epoch seconds without spawning `date` (bash 5 EPOCHSECONDS).
now_epoch() {
  printf '%s' "${EPOCHSECONDS:-$(date +%s)}"
}

# Human duration with seconds, so a 5s tick visibly counts up.
fmt_duration() {
  local s="$1"
  [ "$s" -lt 0 ] && s=0
  if [ "$s" -ge 3600 ]; then
    printf '%d:%02d:%02d' "$((s / 3600))" "$(((s % 3600) / 60))" "$((s % 60))"
  else
    printf '%02d:%02d' "$((s / 60))" "$((s % 60))"
  fi
}

# Fetched runs, one record per line:
# repo<TAB>name<TAB>branch<TAB>start_epoch<TAB>end_epoch<TAB>state<TAB>html_url
# state is running|success|failure|other; end_epoch is 0 while still running.
# Live rows precede completed rows so the pane clamp never hides a running run.
RUNS=""
fetch_runs() {
  local r out wid name br status conclusion started updated url
  local start_epoch end_epoch state rec seen live="" done=""
  RUNS=""
  for r in "${repos[@]}"; do
    # Runs come newest first, so the first line per workflow_id is the newest.
    seen=$'\n'
    out=$(gh api --cache "$cache" \
      "/repos/$r/actions/runs?per_page=$fetch" \
      --jq '.workflow_runs[] | [.workflow_id, .name, (.head_branch // "-"), .status, (.conclusion // "none"), (.run_started_at // .created_at), .updated_at, .html_url] | @tsv' 2>/dev/null) || continue
    while IFS=$'\t' read -r wid name br status conclusion started updated url; do
      [ -n "$name" ] || continue
      case "$seen" in *$'\n'"$wid"$'\n'*) continue ;; esac
      seen="$seen$wid"$'\n'
      if [ "$status" = "completed" ]; then
        end_epoch=$(iso_to_epoch "$updated")
        case "$conclusion" in
          success) state=success ;;
          failure|timed_out|startup_failure|action_required) state=failure ;;
          *) state=other ;;
        esac
      else
        state=running
        end_epoch=0
      fi
      start_epoch=$(iso_to_epoch "$started")
      rec=$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s' \
        "${r##*/}" "$name" "$br" "$start_epoch" "$end_epoch" "$state" "$url")
      if [ "$state" = running ]; then
        if [ -z "$live" ]; then live="$rec"; else live="$live"$'\n'"$rec"; fi
      else
        if [ -z "$done" ]; then done="$rec"; else done="$done"$'\n'"$rec"; fi
      fi
    done <<<"$out"
  done
  if [ -n "$live" ] && [ -n "$done" ]; then RUNS="$live"$'\n'"$done"
  elif [ -n "$done" ]; then RUNS="$done"
  else RUNS="$live"
  fi
}

# Render RUNS into FRAME_BODY / FRAME_N.
FRAME_BODY=""
FRAME_N=0
build_frame() {
  local now line body="" n=0
  local repo name br start_epoch end_epoch state url dot durcolor dur
  now=$(now_epoch)
  if [ -n "$RUNS" ]; then
    while IFS=$'\t' read -r repo name br start_epoch end_epoch state url; do
      [ -n "$name" ] || continue
      case "$state" in
        running)
          dot="$yellow" durcolor="$yellow" dur=$((now - start_epoch))
          ;;
        success)
          dot="$green" durcolor="$dim" dur=$((end_epoch - start_epoch))
          [ $((now - end_epoch)) -gt "$recent" ] && continue
          ;;
        failure)
          dot="$red" durcolor="$dim" dur=$((end_epoch - start_epoch))
          [ $((now - end_epoch)) -gt "$recent" ] && continue
          ;;
        *)
          dot="$dim" durcolor="$dim" dur=$((end_epoch - start_epoch))
          [ $((now - end_epoch)) -gt "$recent" ] && continue
          ;;
      esac
      printf -v line '  %s●%s %s%-18.18s%s %-14.14s %s%-20.20s%s %s%7s%s' \
        "$dot" "$reset" "$bold" "$repo" "$reset" "$name" \
        "$dim" "$br" "$reset" "$durcolor" "$(fmt_duration "$dur")" "$reset"
      # OSC 8 hyperlink, closed right after the row, so Cmd+click opens the run.
      if [ -n "$url" ]; then
        printf -v line '\033]8;;%s\033\\%s\033]8;;\033\\' "$url" "$line"
      fi
      if [ -z "$body" ]; then body="$line"; else body="$body"$'\n'"$line"; fi
      n=$((n + 1))
    done <<<"$RUNS"
  fi
  FRAME_BODY="$body"
  FRAME_N="$n"
}

# Resize our own pane to the wanted height, but only when it actually differs.
resize_self() {
  [ -n "$pane" ] || return 0
  local want="$1" cur
  cur=$(command tmux display-message -p -t "$pane" '#{pane_height}' 2>/dev/null) || return 0
  [ "$cur" = "$want" ] && return 0
  command tmux resize-pane -t "$pane" -y "$want" 2>/dev/null || true
}

last_sig=""
last_poll=0
while true; do
  now=$(now_epoch)
  if [ $((now - last_poll)) -ge "$interval" ]; then
    fetch_runs
    last_poll=$now
  fi
  build_frame
  height="$FRAME_N"
  [ "$height" -lt 1 ] && height=1
  [ "$height" -gt "$maxlines" ] && height="$maxlines"
  resize_self "$height"
  sig="$FRAME_N|$FRAME_BODY"
  if [ "$sig" != "$last_sig" ]; then
    printf '\033[H\033[2J'
    [ -n "$FRAME_BODY" ] && printf '%s' "$FRAME_BODY"
    last_sig="$sig"
  fi
  sleep "$tick"
done
