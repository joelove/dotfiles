#!/usr/bin/env bash
#
# running-actions - one compact line per in-progress GitHub Actions run across a
# set of repos, for a dev-workspace pane. Refreshes until interrupted.
#
# The output is an n-liner: exactly one line per running action (n lines), or a
# dim placeholder when nothing is running.
#
# Repos default to the Candela set. Override by passing repos as arguments or
# setting RUNNING_ACTIONS_REPOS (space-separated). Refresh interval defaults to
# 5 seconds and can be set with RUNNING_ACTIONS_INTERVAL.
#
set -uo pipefail

repos=("$@")
if [ "${#repos[@]}" -eq 0 ]; then
  if [ -n "${RUNNING_ACTIONS_REPOS:-}" ]; then
    read -r -a repos <<<"$RUNNING_ACTIONS_REPOS"
  else
    repos=(
      Candela-Ed/candela-match
      Candela-Ed/candela-eval
      Candela-Ed/candela-orchestrator
      Candela-Ed/candela-infra
      Candela-Ed/candela-cms
    )
  fi
fi
interval="${RUNNING_ACTIONS_INTERVAL:-5}"

if [ -t 1 ]; then
  bold=$'\033[1m' dim=$'\033[2m' yellow=$'\033[33m' reset=$'\033[0m'
else
  bold="" dim="" yellow="" reset=""
fi

elapsed() {
  local start now mins
  start=$(date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$1" +%s 2>/dev/null) || return 0
  now=$(date +%s)
  mins=$(((now - start) / 60))
  if [ "$mins" -ge 60 ]; then
    printf '%dh%02d' "$((mins / 60))" "$((mins % 60))"
  else
    printf '%dm' "$mins"
  fi
}

frame() {
  local r out wf br started total=0
  for r in "${repos[@]}"; do
    out=$(gh run list --repo "$r" --status in_progress --limit 10 \
      --json name,headBranch,startedAt \
      --jq '.[] | [.name, .headBranch, .startedAt] | @tsv' 2>/dev/null || true)
    [ -n "$out" ] || continue
    while IFS=$'\t' read -r wf br started; do
      [ -n "$wf" ] || continue
      printf '  %s●%s %s%-18.18s%s %-14.14s %s%-20.20s%s %s%s%s\n' \
        "$yellow" "$reset" "$bold" "${r##*/}" "$reset" "$wf" \
        "$dim" "$br" "$reset" "$yellow" "$(elapsed "$started")" "$reset"
      total=$((total + 1))
    done <<<"$out"
  done
  [ "$total" -eq 0 ] && printf '  %sno running actions%s\n' "$dim" "$reset"
  return 0
}

while true; do
  printf '\033[H\033[2J'
  frame
  sleep "$interval"
done
