#!/usr/bin/env bash
#
# running-actions - a live, self-sizing readout of in-progress GitHub Actions
# runs across a set of repos, for a dev-workspace pane.
#
# Behaviour:
# - Prints one compact line per running action (an n-liner).
# - Resizes its own tmux pane to n lines (clamped to RUNNING_ACTIONS_MAX_LINES),
#   so the pane it shares vertical space with keeps the rest. At n=0 it collapses
#   to a single empty line, i.e. effectively hidden.
# - Polls every RUNNING_ACTIONS_INTERVAL seconds but only clears/redraws when the
#   content or line count actually changed (no flicker, no wasted work).
# - Uses `gh api --cache` so repeated polls reuse a cached API response instead
#   of re-hitting the API every cycle.
#
# Repos default to the Candela set. Override by passing repos as arguments or
# setting RUNNING_ACTIONS_REPOS (space-separated).
#
set -uo pipefail

repos=("$@")
if [ "${#repos[@]}" -eq 0 ]; then
  if [ -n "${RUNNING_ACTIONS_REPOS:-}" ]; then
    read -r -a repos <<<"$RUNNING_ACTIONS_REPOS"
  else
    repos=(
      Candela-Ed/candela-match
      Candela-Ed/candela-eval
      Candela-Ed/candela-orchestrator
      Candela-Ed/candela-infra
      Candela-Ed/candela-cms
    )
  fi
fi
interval="${RUNNING_ACTIONS_INTERVAL:-30}"
cache="${RUNNING_ACTIONS_CACHE:-60s}"
maxlines="${RUNNING_ACTIONS_MAX_LINES:-8}"

pane="${TMUX_PANE:-}"

if [ -t 1 ]; then
  bold=$'\033[1m' dim=$'\033[2m' yellow=$'\033[33m' reset=$'\033[0m'
else
  bold="" dim="" yellow="" reset=""
fi

elapsed() {
  local start now mins
  start=$(date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$1" +%s 2>/dev/null) || return 0
  now=$(date +%s)
  mins=$(((now - start) / 60))
  if [ "$mins" -ge 60 ]; then
    printf '%dh%02d' "$((mins / 60))" "$((mins % 60))"
  else
    printf '%dm' "$mins"
  fi
}

# Populate FRAME_BODY (rendered lines) and FRAME_N (line count).
FRAME_BODY=""
FRAME_N=0
build_frame() {
  local r out wf br started line body="" n=0
  for r in "${repos[@]}"; do
    out=$(gh api --cache "$cache" \
      "/repos/$r/actions/runs?status=in_progress&per_page=$maxlines" \
      --jq '.workflow_runs[] | [.name, .head_branch, .run_started_at] | @tsv' 2>/dev/null) || continue
    while IFS=$'\t' read -r wf br started; do
      [ -n "$wf" ] || continue
      printf -v line '  %s●%s %s%-18.18s%s %-14.14s %s%-20.20s%s %s%s%s' \
        "$yellow" "$reset" "$bold" "${r##*/}" "$reset" "$wf" \
        "$dim" "$br" "$reset" "$yellow" "$(elapsed "$started")" "$reset"
      if [ -z "$body" ]; then body="$line"; else body="$body"$'\n'"$line"; fi
      n=$((n + 1))
    done <<<"$out"
  done
  FRAME_BODY="$body"
  FRAME_N="$n"
}

# Resize our own pane, but only when the target height actually changed.
last_height=""
resize_self() {
  [ -n "$pane" ] || return 0
  [ "$1" = "$last_height" ] && return 0
  command tmux resize-pane -t "$pane" -y "$1" 2>/dev/null || true
  last_height="$1"
}

last_sig=""
while true; do
  build_frame
  height="$FRAME_N"
  [ "$height" -lt 1 ] && height=1
  [ "$height" -gt "$maxlines" ] && height="$maxlines"
  resize_self "$height"
  sig="$FRAME_N|$FRAME_BODY"
  if [ "$sig" != "$last_sig" ]; then
    printf '\033[H\033[2J'
    [ -n "$FRAME_BODY" ] && printf '%s' "$FRAME_BODY"
    last_sig="$sig"
  fi
  sleep "$interval"
done
