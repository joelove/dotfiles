#!/usr/bin/env bash
#
# running-actions - live view of in-progress GitHub Actions runs across a set
# of repos, for a dev-workspace bottom-strip pane. Refreshes forever until
# interrupted, so it can be used as a pane command directly (no `watch` needed).
#
# Repos default to the Candela set. Override by passing repos as arguments or
# setting RUNNING_ACTIONS_REPOS (space-separated). Refresh interval defaults to
# 5 seconds and can be set with RUNNING_ACTIONS_INTERVAL.
#
set -uo pipefail

repos=("$@")
if [ "${#repos[@]}" -eq 0 ]; then
  if [ -n "${RUNNING_ACTIONS_REPOS:-}" ]; then
    read -r -a repos <<<"$RUNNING_ACTIONS_REPOS"
  else
    repos=(
      Candela-Ed/candela-match
      Candela-Ed/candela-eval
      Candela-Ed/candela-orchestrator
      Candela-Ed/candela-infra
      Candela-Ed/candela-cms
    )
  fi
fi
interval="${RUNNING_ACTIONS_INTERVAL:-5}"

printf_hrule() {
  printf '%-30s %-8s %-22s %-24s %s\n' "------------------------------" "--------" \
    "----------------------" "------------------------" "----------"
}

while true; do
  printf '\033[H\033[2J'
  printf '\033[1mrunning actions\033[0m  %s   (refresh %ss, ctrl-c to stop)\n\n' \
    "$(date '+%H:%M:%S')" "$interval"
  printf '%-30s %-8s %-22s %-24s %s\n' "REPO" "RUN" "WORKFLOW" "BRANCH" "STATUS"
  printf_hrule

  total=0
  for r in "${repos[@]}"; do
    out=$(gh run list --repo "$r" --status in_progress --limit 10 \
      --json databaseId,name,headBranch,status \
      --jq '.[] | [.databaseId, .name, .headBranch, .status] | @tsv' 2>/dev/null || true)
    if [ -n "$out" ]; then
      while IFS=$'\t' read -r id wf br st; do
        printf '%-30s %-8s %-22.22s %-24.24s %s\n' "${r##*/}" "$id" "$wf" "$br" "$st"
        total=$((total + 1))
      done <<<"$out"
    fi
  done

  [ "$total" -eq 0 ] && printf '  no in-progress runs\n'
  printf '\n  %s run(s) across %s repo(s)\n' "$total" "${#repos[@]}"
  sleep "$interval"
done
